package {
    default_applicable_licenses: ["ndk_translation_license"],
}

license {
    name: "ndk_translation_license",
    visibility: [":__subpackages__"],
    license_text: ["ARM_TO_AMD_DBT_LICENSE.txt"],
}

cc_prebuilt_library_shared {
    name: "libndk_translation",
    enabled: false,
    shared_libs: [
        "libc",
        "libc++",
        "libdl",
        "libdl_android",
        "liblog",
        "libm",
    ],
    arch: {
        x86_64: {
            enabled: true,
            srcs: ["prebuilts/lib64/libndk_translation.so"],
        },
    },
}

cc_prebuilt_binary {
    name: "ndk_translation_program_runner_binfmt_misc_arm64",
    compile_multilib: "64",
    enabled: false,
    shared_libs: [
        "libc",
        "libc++",
        "libdl",
        "liblog",
        "libm",
        "libndk_translation",
    ],
    arch: {
        x86_64: {
            enabled: true,
            srcs: ["prebuilts/bin/ndk_translation_program_runner_binfmt_misc_arm64"],
        },
    },
}
