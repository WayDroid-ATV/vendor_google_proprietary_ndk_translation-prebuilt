package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "ndk_translation_proxy_library_defaults",
    defaults: ["berberis_arm_or_arm64_defaults"],
    enabled: false,
    host_supported: false,
    header_libs: [
        "libberberis_guest_abi_headers",
        "libberberis_guest_abi_arm_or_arm64_headers",
        "libberberis_proxy_loader_headers",
    ],
    shared_libs: [
        "libndk_translation",
        "liblog",
    ],
    arch: {
        x86: {
            // We don't have libndk_translation.so for 32-bit at this moment, so disable it for now
            enabled: false,
            stem: "libproxy_arm_to_x86_",
        },
        x86_64: {
            enabled: true,
            stem: "libproxy_arm64_to_x86_64_",
        },
    },
}
