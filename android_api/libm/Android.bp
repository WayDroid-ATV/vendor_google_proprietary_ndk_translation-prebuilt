package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    // TODO(b/232598137): Libm-proxy isn't enabled yet.
    name: "libndk_translation_proxy_libm",
    defaults: [
        "berberis_arm_or_arm64_defaults",
        "native_bridge_proxy_libm_defaults",
    ],
    enabled: false,
    header_libs: [
        "libberberis_guest_abi_arm_or_arm64_headers",
    ],
    shared_libs: [
        "libndk_translation",
        "liblog",
    ],
    arch: {
        x86: {
            // We don't have libndk_translation.so for 32-bit at this moment, so disable it for now
            enabled: false,
            stem: "libproxy_arm_to_x86_libm",
        },
        x86_64: {
            enabled: true,
            stem: "libproxy_arm64_to_x86_64_libm",
        },
    },
}
