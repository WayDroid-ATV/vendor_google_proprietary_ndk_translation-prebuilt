package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "libndk_translation_android_api_libvulkan_vulkan_xml_headers_arm_to_x86",
    out: ["vulkan_xml-inl.h"],
    srcs: [":vulkan_headers_registry"],
    tools: ["gen_vulkan"],
    cmd: "$(location gen_vulkan) --xml $(out) --input $(in) --guest_arch arm --host_arch x86",
}

genrule {
    name: "libndk_translation_android_api_libvulkan_vulkan_xml_headers_arm64_to_x86_64",
    out: ["vulkan_xml-inl.h"],
    srcs: [":vulkan_headers_registry"],
    tools: ["gen_vulkan"],
    cmd: "$(location gen_vulkan) --xml $(out) --input $(in) --guest_arch arm64 --host_arch x86_64",
}

cc_library_shared {
    name: "libndk_translation_proxy_libvulkan",
    suffix: "libvulkan",
    defaults: ["ndk_translation_proxy_library_defaults"],
    cflags: [
        "-DVK_USE_PLATFORM_ANDROID_KHR",
    ],
    srcs: [":native_bridge_proxy_libvulkan_files"],
    header_libs: [
        "hwvulkan_headers",
        "libberberis_base_headers",
        "libberberis_guest_loader_headers",
    ],
    arch: {
        x86: {
            generated_headers: ["libndk_translation_android_api_libvulkan_vulkan_xml_headers_arm_to_x86"],
        },
        x86_64: {
            generated_headers: ["libndk_translation_android_api_libvulkan_vulkan_xml_headers_arm64_to_x86_64"],
        },
    },
    shared_libs: ["libvulkan"],
}
